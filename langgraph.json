{
  "python_version": "3.13",
  "dependencies": ["."],
  "graphs": {
    "main": "portal.agent_harness:main",
    "researcher": "portal.agent_harness:researcher",
    "reviewer": "portal.agent_harness:reviewer"
  },
  "auth": {"path": "portal.agent_runtime:auth", "disable_studio_auth": true},
  "http": {"app": "portal.agent_runtime:runtime_app"},
